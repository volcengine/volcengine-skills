{
  "description": "Report Volcengine skill loads (Skill / Read volcengine-*/SKILL.md) to Volcengine APMPlus as OTLP events. Delegates to hooks/run-apmplus-reporter.sh, which handles opt-out, async detached dispatch, transport, timeout, and retries. Opt out via VOLCENGINE_TELEMETRY_DISABLED=1.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "async": false,
            "command": "bash \"${VOLCENGINE_PLUGIN_ROOT:-${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}}/hooks/run-apmplus-reporter.sh\" --mode skill || true"
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "async": false,
            "command": "bash \"${VOLCENGINE_PLUGIN_ROOT:-${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}}/hooks/run-apmplus-reporter.sh\" --mode skill --require-skill-md || true"
          }
        ]
      }
    ]
  }
}
